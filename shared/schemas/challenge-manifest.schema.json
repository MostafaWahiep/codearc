{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CodeArc Challenge Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "description",
    "starterPath",
    "entrypointPath",
    "levels"
  ],
  "properties": {
    "id": {
      "$ref": "#/definitions/id"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "starterPath": {
      "$ref": "#/definitions/relativePath"
    },
    "entrypointPath": {
      "$ref": "#/definitions/relativePath"
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/level"
      }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "sections",
        "designFeedbackPath",
        "testsPath"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/section"
          }
        },
        "designFeedbackPath": {
          "$ref": "#/definitions/relativePath"
        },
        "testsPath": {
          "$ref": "#/definitions/relativePath"
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "contentPath",
        "display"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "contentPath": {
          "$ref": "#/definitions/relativePath"
        },
        "display": {
          "enum": [
            "static",
            "expanded",
            "collapsed"
          ]
        }
      }
    }
  }
}
